{
  "name": "origenes-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "db:pos": "node scripts/runSql.js ../database/pos ../database/pos/seed",
    "db:caja": "node scripts/runSql.js ../database/caja",
    "dev:token": "node scripts/devToken.js",
    "db:soporte": "node scripts/runSql.js ../database/soporte ../database/soporte/seed",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/runSql.js ../database/soporte/seed"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mssql": "12.7.14",
    "sequelize": "^6.37.8",
    "tedious": "^20.4.3",
    "zod": "4.6.7"
  },
  "overrides": {
    "sequelize": {
      "uuid": "11.1.1"
    }
  }
}
